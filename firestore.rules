rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // G-22: anon/authenticated sahip kendi taslağını yazar; CF admin her zaman geçer.
    match /skdm_sessions/{id} {
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.sessionId == id
        && request.resource.data.status == "draft";
      allow read, update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }
    match /skdm_orders/{id} {
      allow read, write: if false;
    }
    match /skdm_sealed_packages/{id} {
      // Yazma yalnız Admin SDK (Functions /api/seal); sahip okuyabilir
      allow read: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }
  }
}
