rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }

    // Firebase Auth profile: user may maintain only non-privileged own profile fields.
    match /users/{uid} {
      allow create: if self(uid)
        && request.resource.data.keys().hasOnly(['uid','email','displayName','companyName','vkn','role','createdAt'])
        && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'user')
        && (!request.resource.data.keys().hasAny(['uid']) || request.resource.data.uid == uid);
      allow read: if self(uid);
      allow update: if self(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','displayName','companyName','vkn','createdAt'])
        && (!request.resource.data.keys().hasAny(['uid']) || request.resource.data.uid == uid)
        && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == resource.data.role);
      allow delete: if false;

      // Legacy account history used by the current account UI.
      match /packages/{packageId} {
        allow read, create, update: if self(uid);
        allow delete: if false;
      }
    }

    // G-22: authenticated/anonymous owner may persist only its own SKDM draft.
    match /skdm_sessions/{id} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.sessionId == id
        && request.resource.data.status == 'draft';
      allow read: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.sessionId == resource.data.sessionId;
      allow delete: if false;
    }
    match /skdm_orders/{id} { allow read, write: if false; }
    match /skdm_sealed_packages/{id} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    // MARITIME ENTERPRISE BOUNDARY
    // All compliance records, membership/RBAC, revisions, version manifests and audit events
    // are written/read through the authenticated maritimeApi. Admin SDK bypasses these rules.
    // This prevents the browser from forging ownerId, role, revision, readiness, hashes or audit history.
    match /maritimeUserHomes/{uid} { allow read, write: if false; }
    match /companies/{companyId} {
      allow read, write: if false;
      match /{document=**} { allow read, write: if false; }
    }

    // Fail closed for every collection not explicitly listed above.
    match /{document=**} { allow read, write: if false; }
  }
}
