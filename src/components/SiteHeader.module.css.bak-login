/* Header — taşma düzeltmesi.
   OLAY: sağda dört öğe yarışıyordu (kullanıcı çipi, "Dosyama dön",
   "Yeni dosya", "Menü"). Dar ekranda çip nav linkinin üstüne biniyor,
   buton metinleri iki satıra kırılıyordu. Ayrıca nav gizlendiği halde
   "Menü" ayrı duruyordu — iki taşma mekanizması aynı anda çalışıyordu.
   KURAL: sağda TEK birincil eylem. Buton metni satır kırmaz. */

.header { position: sticky; top: 0; z-index: 40;
  background: var(--baslik-zemin, #213110); color: var(--baslik-metin, #F2F5E9); }

.satir { display: flex; align-items: center; gap: 16px;
  max-width: 1320px; margin: 0 auto; padding: 10px 20px; min-height: 64px; }

.marka { display: flex; align-items: center; gap: 10px; flex: 0 0 auto;
  text-decoration: none; color: inherit; }
.markaIsaret { width: 34px; height: 34px; flex: 0 0 auto; }
.markaYazi { display: flex; flex-direction: column; line-height: 1.1; }
.markaAd { font-size: 19px; font-weight: 700; letter-spacing: -0.01em; white-space: nowrap; }
.markaAlt { font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase;
  opacity: 0.72; white-space: nowrap; }

/* min-width:0 olmadan flex ogesi icerikten kucukmez ve komsusuna biner —
   ustteki hatanin teknik sebebi buydu. */
.gezinme { display: none; flex: 1 1 auto; min-width: 0;
  justify-content: center; gap: clamp(12px, 1.8vw, 28px); }
.gezinmeBag { color: inherit; text-decoration: none; font-size: 15px;
  white-space: nowrap; padding: 6px 2px; border-bottom: 2px solid transparent; }
.gezinmeBag:hover, .gezinmeBag:focus-visible { border-bottom-color: currentColor; }

.saglik { display: flex; align-items: center; gap: 10px; flex: 0 0 auto; margin-left: auto; }

.birincil { display: inline-flex; align-items: center; justify-content: center;
  white-space: nowrap; background: var(--vurgu, #bdd652);
  color: var(--vurgu-metin, #213110); font: inherit; font-size: 15px;
  font-weight: 700; border: none; border-radius: 10px; padding: 11px 18px;
  cursor: pointer; text-decoration: none; }
.birincil:hover { filter: brightness(1.06); }

.kullaniciSarmal { position: relative; flex: 0 0 auto; }
.kullaniciDugme { display: inline-flex; align-items: center; gap: 8px;
  background: transparent; color: inherit; font: inherit;
  border: 1.5px solid rgba(255,255,255,0.28); border-radius: 10px;
  padding: 7px 10px; cursor: pointer; max-width: 180px; }
.kullaniciDugme:hover { border-color: rgba(255,255,255,0.55); }
.rozet { width: 26px; height: 26px; flex: 0 0 auto; display: grid;
  place-items: center; border-radius: 7px; background: var(--vurgu, #bdd652);
  color: var(--vurgu-metin, #213110); font-size: 13px; font-weight: 700; }
.kullaniciAd { display: none; font-size: 14px; white-space: nowrap;
  overflow: hidden; text-overflow: ellipsis; }
.okIsareti { flex: 0 0 auto; opacity: 0.7; }

.menuPanel { position: absolute; top: calc(100% + 8px); right: 0;
  min-width: 248px; background: var(--kart, #FFFFFF); color: var(--metin, #0a1826);
  border: 1px solid var(--cizgi, #c8d8d0); border-radius: 12px;
  box-shadow: 0 12px 32px rgba(0,0,0,0.16); padding: 6px; z-index: 50; }
.menuBaslik { padding: 10px 12px 8px; font-size: 12px; letter-spacing: 0.06em;
  text-transform: uppercase; opacity: 0.6; }
.menuOge { display: block; width: 100%; text-align: left; background: none;
  border: none; font: inherit; font-size: 14.5px; color: inherit;
  padding: 10px 12px; border-radius: 8px; cursor: pointer; text-decoration: none; }
.menuOge:hover { background: var(--zemin-yumusak, #f6f9ef); }
.menuAyrac { height: 1px; margin: 6px 4px; background: var(--cizgi, #c8d8d0); border: none; }

.cekmeceDugme { display: inline-flex; align-items: center; justify-content: center;
  width: 42px; height: 42px; background: transparent; color: inherit;
  border: 1.5px solid rgba(255,255,255,0.28); border-radius: 10px;
  cursor: pointer; flex: 0 0 auto; }
.cekmece { border-top: 1px solid rgba(255,255,255,0.16); padding: 8px 20px 16px; }
.cekmeceListe { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
.cekmeceBag { display: block; color: inherit; text-decoration: none;
  font-size: 16px; padding: 12px 4px; border-bottom: 1px solid rgba(255,255,255,0.1); }

/* Tek esik: 900px. Ustunde nav gorunur + cekmece gizli. Altinda tersi.
   Ikisi ASLA ayni anda olmaz. */
@media (min-width: 640px) { .kullaniciAd { display: block; } }
@media (min-width: 900px) {
  .gezinme { display: flex; }
  .cekmeceDugme { display: none; }
  .cekmece { display: none; }
}
@media (max-width: 400px) {
  .markaAlt { display: none; }
  .birincil { padding: 10px 13px; font-size: 14px; }
}
@media (prefers-reduced-motion: reduce) {
  .header * { transition: none !important; animation: none !important; }
}

.gizli { position: absolute; width: 1px; height: 1px; overflow: hidden;
  clip: rect(0 0 0 0); white-space: nowrap; }
